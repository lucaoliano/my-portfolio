{
  "name": "my-portfolio",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "firebase": "13.3.0",
    "lucide-react-native": "1.73.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-chart-kit": "7.0.4",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-unused-imports": "4.4.1",
    "firebase-tools": "15.36.0",
    "typescript": "6.0.3",
    "workbox-cli": "7.4.1"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build": "expo export -p web && npx workbox generateSW workbox-config.js",
    "serve": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "npm --prefix functions run build && firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:all": "npm run build && firebase deploy",
    "test:calc": "npx --yes tsx scripts/check-calculations.ts"
  },
  "private": true,
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "fsevents@2.3.3": true,
    "re2@1.27.0": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true,
    "google-logging-utils@1.2.0": true
  }
}
