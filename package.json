{
  "name": "my-portfolio",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.27",
    "expo-clipboard": "57.0.2",
    "expo-constants": "57.0.21",
    "expo-linking": "57.0.12",
    "expo-local-authentication": "57.0.3",
    "expo-router": "57.0.25",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "firebase": "12.19.0",
    "lucide-react-native": "1.54.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-chart-kit": "7.0.4",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.3",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@types/react": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "firebase-tools": "15.33.0",
    "typescript": "6.0.3",
    "workbox-cli": "7.4.1"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build": "expo export -p web && npx workbox generateSW workbox-config.js",
    "serve": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "npm --prefix functions run build && firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:all": "npm run build && firebase deploy"
  },
  "private": true,
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "fsevents@2.3.3": true,
    "re2@1.27.0": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true,
    "google-logging-utils@1.2.0": true
  }
}
